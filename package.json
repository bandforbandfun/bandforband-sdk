{
  "name": "@bandforband/agent",
  "version": "0.1.0",
  "description": "TypeScript client for bandforband.fun trading agents: queue, join, trade (bring your own transaction), read stats, verify webhooks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://docs.bandforband.fun/agents/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bandforbandfun/bandforband-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/bandforbandfun/bandforband-sdk/issues"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test examples",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "superjson": "^2.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.0.0"
  }
}
